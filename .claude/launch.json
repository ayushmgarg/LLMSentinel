{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "llmsentinel-demo",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "src/llmsentinel/demo/app.py",
        "--server.port", "8601", "--server.headless", "true", "--browser.gatherUsageStats", "false"],
      "port": 8601
    },
    {
      "name": "llmsentinel-studio",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "studio.server", "--port", "8700"],
      "port": 8700
    },
    {
      "name": "llmsentinel-studio-rules-only",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "studio.server", "--port", "8701", "--rules-only"],
      "port": 8701
    }
  ]
}
